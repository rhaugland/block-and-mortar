generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Property (Apartment Complex) ───────────────────────────────────

model Property {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  address     String
  city        String
  state       String
  zip         String
  lat         Float
  lng         Float
  websiteUrl  String?
  contactName String?
  email       String   @unique
  password    String
  apiKey        String   @unique @default(cuid())
  widgetEnabled  Boolean   @default(true)
  widgetLastPing DateTime?
  widgetStyle    Json?
  revSharePct    Float     @default(0.25)
  monthlyReport  Boolean   @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locations   Location[]
  impressions Impression[]
  clicks      Click[]
  redemptions Redemption[]
  payouts     Payout[]
}

// ─── Location (individual apartment community) ──────────────────────

model Location {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  address    String
  city       String
  state      String
  zip        String
  lat        Float
  lng        Float
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

// ─── Business ───────────────────────────────────────────────────────

model Business {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  address          String
  city             String
  state            String
  zip              String
  lat              Float
  lng              Float
  phone            String?
  websiteUrl       String?
  logoUrl          String?
  category         String
  contactName      String?
  email            String   @unique
  password         String
  stripeCustomerId String?
  budgetCents      Int       @default(0)
  budgetAlertSent  Int       @default(0) // last threshold notified: 0, 80, 90, 95
  monthlyReport    Boolean   @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  offers         Offer[]
  impressions    Impression[]
  clicks         Click[]
  redemptions    Redemption[]
  invoices       Invoice[]
  featuredBoosts FeaturedBoost[]
}

// ─── Offer (Coupon / Deal) ──────────────────────────────────────────

model Offer {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  description String
  imageUrl    String?
  redeemUrl   String?
  radiusMiles Float     @default(3.0)
  budgetCents Int       @default(10000)
  spentCents  Int       @default(0)
  cpcCents    Int       @default(50)
  active       Boolean   @default(true)
  startsAt     DateTime  @default(now())
  expiresAt    DateTime? // campaign end date (startsAt + campaignDays) — when offer stops showing on widgets
  campaignDays Int?      // how many days the offer runs on apartment sites
  redeemDays   Int       @default(7) // how many days a user has to redeem after claiming
  createdAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  impressions    Impression[]
  clicks         Click[]
  redemptions    Redemption[]
  featuredBoosts FeaturedBoost[]

  @@index([businessId])
  @@index([active])
}

// ─── Tracking ───────────────────────────────────────────────────────

model Impression {
  id         String   @id @default(cuid())
  offerId    String
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([offerId])
  @@index([propertyId])
  @@index([createdAt])
}

model Click {
  id         String   @id @default(cuid())
  offerId    String
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([offerId])
  @@index([propertyId])
  @@index([createdAt])
}

// ─── Redemption ─────────────────────────────────────────────────

model Redemption {
  id         String    @id @default(cuid())
  token      String    @unique @default(cuid())
  offerId    String
  offer      Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String
  redeemedAt DateTime?
  expiresAt  DateTime? // per-user deadline to redeem (claimedAt + offer.redeemDays)
  createdAt  DateTime  @default(now())

  @@index([token])
  @@index([offerId])
  @@index([email])
}

// ─── Payouts ───────────────────────────────────────────────────────

model Payout {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amountCents     Int
  clickCount      Int
  periodStart     DateTime
  periodEnd       DateTime
  tremendousId    String?
  tremendousLink  String?
  status          String   @default("pending") // pending, sent, failed
  failReason      String?
  createdAt       DateTime @default(now())

  @@index([propertyId])
  @@index([status])
}

// ─── Invoice (Business billing) ─────────────────────────────────

model Invoice {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amountCents     Int
  clickCount      Int
  periodStart     DateTime
  periodEnd       DateTime
  stripeInvoiceId String?  @unique
  stripeHostedUrl String?
  status          String   @default("pending") // pending, paid, failed, void
  failReason      String?
  createdAt       DateTime @default(now())

  @@index([businessId])
  @@index([status])
}

// ─── Support Tickets ────────────────────────────────────────────

model SupportTicket {
  id        String   @id @default(cuid())
  name      String
  email     String
  role      String   // business, property, admin
  subject   String
  message   String
  status    String   @default("open") // open, replied, closed
  reply     String?
  repliedAt DateTime?
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// ─── Featured Boosts ────────────────────────────────────────────

model FeaturedBoost {
  id          String   @id @default(cuid())
  offerId     String
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date // the calendar date this boost is active
  amountCents Int      @default(2500) // $25/day default
  status      String   @default("active") // active, cancelled
  createdAt   DateTime @default(now())

  @@unique([offerId, date])
  @@index([businessId])
  @@index([date])
  @@index([status])
}

// ─── Outbound Emails ────────────────────────────────────────────

model OutboundEmail {
  id          String   @id @default(cuid())
  toEmail     String
  toFirstName String?
  toLastName  String?
  subject     String
  body        String
  bodyHtml    String?  @db.Text
  status      String   @default("sent") // sent, failed
  createdAt   DateTime @default(now())

  @@index([toEmail])
  @@index([createdAt])
}

// ─── Inbound Emails (replies received) ──────────────────────────

model InboundEmail {
  id        String   @id @default(cuid())
  fromEmail String
  fromName  String?
  subject   String
  bodyText  String?  @db.Text
  bodyHtml  String?  @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([fromEmail])
  @@index([createdAt])
  @@index([read])
}

// ─── Password Reset ──────────────────────────────────────────────

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  role      String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}
