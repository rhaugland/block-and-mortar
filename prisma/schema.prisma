generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Property (Apartment Complex) ───────────────────────────────────

model Property {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  address     String
  city        String
  state       String
  zip         String
  lat         Float
  lng         Float
  websiteUrl  String?
  contactName String?
  email       String   @unique
  password    String
  apiKey        String   @unique @default(cuid())
  widgetEnabled  Boolean   @default(true)
  widgetLastPing DateTime?
  widgetStyle    Json?
  revSharePct    Float     @default(0.25)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locations   Location[]
  impressions Impression[]
  clicks      Click[]
  redemptions Redemption[]
  payouts     Payout[]
}

// ─── Location (individual apartment community) ──────────────────────

model Location {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  address    String
  city       String
  state      String
  zip        String
  lat        Float
  lng        Float
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

// ─── Business ───────────────────────────────────────────────────────

model Business {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  address          String
  city             String
  state            String
  zip              String
  lat              Float
  lng              Float
  phone            String?
  websiteUrl       String?
  logoUrl          String?
  category         String
  contactName      String?
  email            String   @unique
  password         String
  stripeCustomerId String?
  budgetCents      Int       @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  offers      Offer[]
  impressions Impression[]
  clicks      Click[]
  redemptions Redemption[]
}

// ─── Offer (Coupon / Deal) ──────────────────────────────────────────

model Offer {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  description String
  imageUrl    String?
  redeemUrl   String?
  radiusMiles Float     @default(3.0)
  budgetCents Int       @default(10000)
  spentCents  Int       @default(0)
  cpcCents    Int       @default(50)
  active      Boolean   @default(true)
  startsAt    DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  impressions Impression[]
  clicks      Click[]
  redemptions Redemption[]

  @@index([businessId])
  @@index([active])
}

// ─── Tracking ───────────────────────────────────────────────────────

model Impression {
  id         String   @id @default(cuid())
  offerId    String
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([offerId])
  @@index([propertyId])
  @@index([createdAt])
}

model Click {
  id         String   @id @default(cuid())
  offerId    String
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([offerId])
  @@index([propertyId])
  @@index([createdAt])
}

// ─── Redemption ─────────────────────────────────────────────────

model Redemption {
  id         String    @id @default(cuid())
  token      String    @unique @default(cuid())
  offerId    String
  offer      Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([token])
  @@index([offerId])
  @@index([email])
}

// ─── Payouts ───────────────────────────────────────────────────────

model Payout {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amountCents     Int
  clickCount      Int
  periodStart     DateTime
  periodEnd       DateTime
  tremendousId    String?
  tremendousLink  String?
  status          String   @default("pending") // pending, sent, failed
  failReason      String?
  createdAt       DateTime @default(now())

  @@index([propertyId])
  @@index([status])
}

// ─── Password Reset ──────────────────────────────────────────────

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  role      String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}
